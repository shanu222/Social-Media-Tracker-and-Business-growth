# Copy to .env for local development. NEVER commit a real .env file.
# On Railway, set these in the service's "Variables" tab instead.

NODE_ENV=development
PORT=4000

# Railway Postgres provides this automatically when you reference the database:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/smt
# Set to true if your database requires SSL (most hosted DBs outside Railway's private network)
DATABASE_SSL=false

# Generate both with:  npm run gen:secrets
JWT_SECRET=
ENCRYPTION_KEY=
JWT_EXPIRES_IN=12h

# Your Vercel URL(s), comma separated, no trailing slash
CORS_ORIGINS=http://localhost:5173

# First admin account — created only when no users exist. Remove the password after first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Owner

# Social Media Manager login — created once, must choose a new password at first sign-in.
# Keep these ONLY in Railway variables; remove MANAGER_PASSWORD after the first sign-in.
MANAGER_EMAIL=
MANAGER_PASSWORD=
MANAGER_NAME=Social Media Manager

# Email (pick one). Resend works on every Railway plan; Railway only allows SMTP on paid plans.
RESEND_API_KEY=
EMAIL_FROM=Growth Desk <tasks@yourdomain.com>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Your Vercel URL, used for "Open task" buttons in emails
APP_URL=https://your-app.vercel.app
REMINDER_DAYS_BEFORE=2

# AI task assistant (Claude). Get a key at console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Large direct-to-R2 uploads (needs the bucket CORS rule in README)
MAX_DIRECT_UPLOAD_GB=5

# Official API keys for automatic follower counts (optional)
YOUTUBE_API_KEY=
TELEGRAM_BOT_TOKEN=
SYNC_CRON=15 */6 * * *
REMINDER_CRON=0 9 * * *

# Cloudflare R2 (keep the bucket private). Optional: uploads & cloud backups are off until set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Nightly encrypted backup to R2 (cron syntax, in APP_TIMEZONE)
BACKUP_CRON=0 2 * * *
APP_TIMEZONE=Asia/Karachi
MAX_UPLOAD_MB=25
