# Copy to .env for local development. NEVER commit a real .env file.
# On Railway, set these in the service's "Variables" tab instead.

NODE_ENV=development
PORT=4000

# Railway Postgres provides this automatically when you reference the database:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/smt
# Set to true if your database requires SSL (most hosted DBs outside Railway's private network)
DATABASE_SSL=false

# Generate both with:  npm run gen:secrets
JWT_SECRET=
ENCRYPTION_KEY=
JWT_EXPIRES_IN=12h

# Your Vercel URL(s), comma separated, no trailing slash
CORS_ORIGINS=http://localhost:5173

# First admin account — created only when no users exist. Remove the password after first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Owner

# Cloudflare R2 (keep the bucket private). Optional: uploads & cloud backups are off until set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Nightly encrypted backup to R2 (cron syntax, in APP_TIMEZONE)
BACKUP_CRON=0 2 * * *
APP_TIMEZONE=Asia/Karachi
MAX_UPLOAD_MB=25
